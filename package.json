{
  "name": "video-scraper",
  "version": "0.1.0",
  "description": "多平台视频批量爬取工具",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite electron-vite dev",
    "build": "electron-vite build",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "check:css": "node scripts/check-css.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:css"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sherpa-onnx-node": "^1.13.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
